{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "/usr/share/nextfox/fastfetch/logo.txt",
    "padding": {
      "top": 1,
      "left": 1
    }
  },

  "display": {
    "separator": " 󰇙 "
  },

  "modules": [
    "break",

    {
      "type": "title",
      "color": {
        "user": "red",
        "at": "white",
        "host": "red"
      }
    },

    "break",

    {
      "type": "os",
      "key": "󰣇 OS"
    },

    {
      "type": "host",
      "key": "󰍹 Host"
    },

    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },

    {
      "type": "uptime",
      "key": "󱫐 Uptime"
    },

    {
      "type": "packages",
      "key": "󰏖 Packages"
    },

    {
      "type": "shell",
      "key": "󰆍 Shell"
    },

    {
      "type": "terminal",
      "key": "󰆍 Terminal"
    },

    {
      "type": "wm",
      "key": "󱂬 Window Manager"
    },

    {
      "type": "de",
      "key": "󰧨 Desktop"
    },

    {
      "type": "theme",
      "key": "󰉼 Theme"
    },

    {
      "type": "icons",
      "key": "󰀻 Icons"
    },

    {
      "type": "cursor",
      "key": "󰆿 Cursor"
    },

    {
      "type": "font",
      "key": "󰛖 Font"
    },

    "break",

    {
      "type": "cpu",
      "key": "󰻠 CPU"
    },

    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },

    {
      "type": "memory",
      "key": "󰍛 Memory"
    },

    {
      "type": "disk",
      "key": "󰋊 Disk"
    },

    "break",

    {
      "type": "localip",
      "key": "󰩠 Local IP"
    },

    {
      "type": "battery",
      "key": "󰁹 Battery"
    },

    {
      "type": "locale",
      "key": "󰗊 Locale"
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 2
    }
  ]
}
